# Contracts .env — DO NOT COMMIT TO GIT
# ─────────────────────────────────────────────────────────────────────────────

# Deployer wallet private key (the wallet that pays gas to deploy contracts)
# ⚠️ Generate a NEW wallet for deployment — never use your main wallet
# Get free Amoy test MATIC from: https://faucet.polygon.technology
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY_HERE

# Minter wallet (our backend server calls mint() using this wallet)
# This can be the same as deployer on testnet, but separate on mainnet
MINTER_WALLET_ADDRESS=0xYOUR_MINTER_WALLET_ADDRESS_HERE

# Treasury wallet (receives platform commission on each sale)
TREASURY_WALLET_ADDRESS=0xYOUR_TREASURY_WALLET_ADDRESS_HERE

# Platform commission in basis points (1000 = 10%, 500 = 5%)
PLATFORM_COMMISSION_BPS=1000

# RPC URLs — Free tier from Alchemy or Infura
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
POLYGON_MAINNET_RPC_URL=https://polygon-rpc.com

# Polygonscan API key for contract verification
# Get from: https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=YOUR_POLYGONSCAN_API_KEY
